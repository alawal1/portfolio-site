---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
    { href: `${base}about/`, text: 'About Me' },
      { href: `${base}cv/`, text: 'CV' },
  { href: `${base}projects/`, text: 'Projects' },

  { href: `${base}contact/`, text: 'Contact' },
];
const current = (href: string) => Astro.url.pathname.startsWith(href.replace(/\/$/, '')) ? 'page' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfolio of Amina Lawal" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | Amina Lawal</title>
    <script is:inline>
      try {
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a href={base} class="brand">Amina Lawal</a>
        {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.text}</a>)}
        <button id="theme-toggle" aria-label="Toggle dark mode"></button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Amina Lawal. All rights reserved.</p>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').onclick = () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.theme = dark ? 'dark' : 'light'; } catch {}
      };
    </script>
  </body>
</html>
