---
import Layout from '../layouts/Layout.astro';

const projects = [
  // {
  //   title: 'Chinook Music Store — Genre Revenue Analysis',
  //   description: 'SQL + Tableau analysis of 25 genres to identify which deserve investment and which are dead weight.',
  //   url: `${import.meta.env.BASE_URL}projects/chinook`,
  // },
  {
    title: 'Job Fit Agent',
    description: 'A Python agent that reads job postings and returns apply / borderline / skip verdicts using OpenAI tool-calling',
    url: `${import.meta.env.BASE_URL}projects/job-fit-agent`,
  },
  {
  title: 'Research Radar',
  description: 'A weekly agent that monitors new AI governance research and produces an overview of new research.',
  url: `${import.meta.env.BASE_URL}projects/research-radar`,
},
  {
    title: 'Job Alert',
    description: 'A weekly scheduled playbook that checks several (hard-coded)) companies for new entry-level jobs, judges each one against my CV and saves an overview on my Mac',
    url: `${import.meta.env.BASE_URL}projects/job-alert`,
  },
    {
    title: 'Work Companion',
    description: 'A Claude skill that keeps my Notion tracker up to date. "wrap up" logs what I did, updates tasks, learnings and skills; "where was I" tells me what´s on deck.',
    url: `${import.meta.env.BASE_URL}projects/work-companion`,
  }
];
---
<Layout title="Projects">
  <h1>Projects</h1>
  <ul class="projects">
    {projects.map((project) => (
      <li>
        <a href={project.url} tabindex="-1" aria-hidden="true"></a>
        <h3><a href={project.url}>{project.title}</a></h3>
        <p>{project.description}</p>
      </li>
    ))}
  </ul>
</Layout>
